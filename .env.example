# Supabase
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# AI (OpenRouter)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="openai/gpt-oss-20b:free"

# Paddle — LIVE credentials
# Frontend: get from Paddle Dashboard → Developer → Authentication
VITE_PADDLE_VENDOR_ID="live_..."
VITE_PADDLE_ENV="production"
VITE_PADDLE_PRICE_ID_MONTHLY="pri_..."
VITE_PADDLE_PRICE_ID_YEARLY="pri_..."

# Server-side: get from Paddle Dashboard → Developer → Authentication
PADDLE_API_KEY="your-paddle-api-key"
PADDLE_WEBHOOK_SECRET="your-webhook-signing-secret"

# Subscription feature flag (set to "true" only in development)
ALLOW_TEST_SUBSCRIPTION="false"
